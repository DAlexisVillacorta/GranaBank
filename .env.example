# En producción las mismas variables se configuran en Vercel

# Base de datos (Supabase Postgres) 
# Usar la connection string del pooler en modo Session (puerto 5432).
# En Supabase: Project Settings → Database → Connection string → URI (session).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Autenticación
# Secreto para firmar tokens JWT. Generar con: openssl rand -base64 48
JWT_SECRET="change-me-please-min-32-chars-long-random-string"

# Entorno 
NODE_ENV="development"
